root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces mark a hard line break.
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[doc/palettes/*.json]
indent_style = space
indent_size = 2
