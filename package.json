	"description": "Pi extension to visualize context usage and inspect the hidden parts: base prompt, tools defs, and extension injections",
	"type": "module",
	"license": "MIT",
	"author": "Dmitry Makarov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dimk90/pi-context-view.git"
	},
	"homepage": "https://github.com/dimk90/pi-context-view#readme",
	"bugs": {
		"url": "https://github.com/dimk90/pi-context-view/issues"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"pi-package",
		"coding-agent",
		"context",
		"tokens",
		"tui"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
